[Unit]
# OnFailure handler for buzz-mirror.service. Templated on the failed unit name
# so the message says what failed rather than "something did".
#
# This exists because moving off Coolify lost its Scheduled Task Failure
# notification, which was covering two things at once: a run that failed, and a
# run that never happened. This unit covers the first. The second is covered by
# fleet-audit asserting on $MIRROR_STATE_DIR/last-success - a timer that stops
# firing produces no failure to hook, so nothing here can see it.
Description=Report a failed mirror run (%i)

[Service]
Type=oneshot
ExecStart=/opt/buzz-mirror/alert.sh %i
# The alert must not become the outage. If Buzz is unreachable the failure is
# still in the journal, and fleet-audit still notices the stale last-success.
SuccessExitStatus=0 1
