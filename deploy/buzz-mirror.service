[Unit]
# One reconcile pass. INFRA-BOX. Started by buzz-mirror.timer, never enabled
# directly - there is no daemon here, only a scheduled one-shot.
#
# Why a systemd timer and not a Coolify scheduled task: Coolify's scheduled
# tasks `docker exec` into an already-running container, which meant keeping a
# `sleep infinity` container alive purely to be an exec target, and it meant the
# GitHub App PEM sitting in Coolify's database as an app env var. On infra-box
# the token issuer is local, so the mirror gets a short-lived installation token
# instead and holds no long-lived GitHub credential at all.
Description=Mirror Buzz and GitHub main refs, one pass
Documentation=https://github.com/gitcoinco/buzz-mirror-bot/blob/main/docs/MIRROR.md
After=docker.service network-online.target
Requires=docker.service
OnFailure=buzz-mirror-alert@%n.service

[Service]
Type=oneshot
ExecStart=/opt/buzz-mirror/run-once.sh
# Generous: a first run clones every mirrored repo from scratch. Steady-state
# runs are seconds. Shorter than the timer interval on purpose - see the timer.
TimeoutStartSec=600

# systemd will not run a second instance of this unit while one is active, so
# overlapping runs cannot happen here. sync.py keeps its flock anyway: it costs
# nothing and it still covers a hand-run `docker run` alongside a timed one.

[Install]
WantedBy=multi-user.target
